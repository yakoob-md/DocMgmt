@model DocMgmt.Models.DocumentUploadViewModel

@{
    ViewData["Title"] = "Upload Document Version";
}

<div class="container mt-4">
    <div class="row">
        <!-- LEFT PANEL: Original upload forms and transaction logs -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white font-weight-bold">
                    Upload Management Interface
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success small py-2">@TempData["Success"]</div>
                    }

                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DocId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Select Target File Asset</label>
                            <input type="file" asp-for="File" id="documentFileInput" class="form-control" />
                            <span asp-validation-for="File" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 font-weight-bold">
                            Commit Upload Update Version
                        </button>
                    </form>
                </div>
            </div>

            <!-- Upload Version Control Tracking History -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white font-weight-bold">
                    Database Retention History
                </div>
                <div class="card-body p-0">
                    @if (Model.UploadHistory != null && Model.UploadHistory.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.UploadHistory)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <div>
                                        <h6 class="mb-0 text-truncate" style="max-width: 220px;">@item.FileName</h6>
                                        <small class="text-muted">@item.UploadedAt?.ToString("g")</small>
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary px-2" onclick="loadSavedPreview(@item.UploadId, '@System.IO.Path.GetExtension(item.FileName).ToLowerInvariant()')">
                                            Inline
                                        </button>
                                        <a href="/Documents/Preview?uploadId=@item.UploadId" target="_blank" class="btn btn-sm btn-outline-dark px-2">
                                            Tab ↗
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-muted text-center small">No previous record entries found.</div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: 100% First-Party Native Live Preview Panel Workspace -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px; z-index: 10;">
                <div class="card-header bg-dark text-white font-weight-bold d-flex justify-content-between align-items-center">
                    <span>Live Native View Engine Context</span>
                    <span id="stateBadge" class="badge bg-secondary text-uppercase small">Empty</span>
                </div>
                <div class="card-body bg-light border p-2" id="previewDisplayPanel" style="min-height: 480px; max-height: 650px; overflow: auto;">
                    <div class="text-center text-muted pt-5 mt-5">
                        <p class="mb-0 fs-5 font-italic">Select a file from your system directory or choose an item from upload history records to render live contents dynamically.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const panel = document.getElementById('previewDisplayPanel');
        const badge = document.getElementById('stateBadge');

        // --- PIPELINE 1: LIVE INTERCEPT BEFORE SUBMISSION STATE ---
        document.getElementById('documentFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const extension = '.' + file.name.split('.').pop().toLowerCase();
            badge.innerText = "Before Submit";
            badge.className = "badge bg-warning text-dark";

            if (extension === '.docx' || extension === '.xlsx') {
                panel.innerHTML = '<div class="text-center pt-5 mt-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Parsing file structure out of HTTP memory streams...</p></div>';

                let formData = new FormData();
                formData.append("file", file);

                fetch('/Documents/PreviewBeforeSubmit', {
                    method: 'POST',
                    body: formData
                })
                .then(res => {
                    if (!res.ok) throw new Error("File conversion streaming error.");
                    return res.text();
                })
                .then(htmlContent => {
                    panel.innerHTML = htmlContent;
                })
                .catch(err => {
                    panel.innerHTML = `<div class="alert alert-danger m-3 small">${err.message}</div>`;
                });
            }
            else if (['.pdf', '.png', '.jpg', '.jpeg', '.txt'].includes(extension)) {
                const localBlobUrl = URL.createObjectURL(file);

                if (extension === '.pdf') {
                    panel.innerHTML = `<embed src="${localBlobUrl}" type="application/pdf" style="width:100%; height:550px;" />`;
                } else if (extension === '.txt') {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        panel.innerHTML = `<pre class="p-3 bg-white border small m-2" style="white-space: pre-wrap;">${evt.target.result}</pre>`;
                    };
                    reader.readAsText(file);
                } else {
                    panel.innerHTML = `<div class="text-center p-2"><img src="${localBlobUrl}" class="img-fluid rounded border shadow-sm" style="max-height: 520px;" /></div>`;
                }
            } else {
                panel.innerHTML = `<div class="alert alert-secondary m-3 small">Preview unavailable for format type: ${extension}. The file can still be saved directly.</div>`;
            }
        });

        // --- PIPELINE 2: LIVE RETRIEVAL AFTER SUBMISSION STATE ---
        function loadSavedPreview(uploadId, extension) {
            badge.innerText = "Database Record";
            badge.className = "badge bg-info text-white";
            panel.innerHTML = '<div class="text-center pt-5 mt-4"><div class="spinner-border text-secondary" role="status"></div><p class="mt-2 text-muted">Retrieving byte matrix from server storage arrays...</p></div>';

            if (extension === '.docx' || extension === '.xlsx') {
                fetch(`/Documents/Preview?uploadId=${uploadId}`)
                    .then(res => res.text())
                    .then(html => { panel.innerHTML = html; })
                    .catch(() => { panel.innerHTML = '<div class="alert alert-danger m-3 small">Error pulling document components.</div>'; });
            }
            else if (['.pdf', '.png', '.jpg', '.jpeg', '.txt'].includes(extension)) {
                panel.innerHTML = `<iframe src="/Documents/Preview?uploadId=${uploadId}" style="width:100%; height:550px; border:none; background:#fff;"></iframe>`;
            } else {
                panel.innerHTML = `<div class="alert alert-secondary m-3 small">Direct inline views are unsupported for ${extension}. Click 'Tab ↗' to force external window verification routing.</div>`;
            }
        }
    </script>
}
